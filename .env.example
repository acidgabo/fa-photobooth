# Puerto donde corre este backend (el frontend le habla aquí)
PORT=4000

# ---- Watchdog de sesión colgada ----
# Si NetPay nunca confirma el pago (awaiting_payment) o dslrBooth deja de
# mandar eventos a medio camino (booth_running), el backend fuerza la
# sesión a "error" tras este tiempo, en vez de quedarse colgado para
# siempre. Ver src/sessionState.js.
# PAYMENT_TIMEOUT_MS: deliberadamente más largo que el timeout de 30s que
# ya tiene el frontend (public/index.html) — este es el respaldo del
# backend por si el navegador del kiosco se recarga o el JS truena antes
# de que su propio timeout dispare.
PAYMENT_TIMEOUT_MS=180000
# BOOTH_TIMEOUT_MS: se reinicia con cada evento nuevo de dslrBooth
# (countdown, capture_start, printing...), así que detecta "sin avance
# por X tiempo", no solo la ausencia del session_end final. 2 minutos da
# margen de sobra para el paso más lento normal (impresión).
BOOTH_TIMEOUT_MS=120000

# ---- NetPay Smart API ----
# Mientras no haya cuenta de desarrollador: apuntar al mock local
# (node mocks/mock-netpay.js). Cuando llegue el sandbox real, cambiar a
# https://sandbox.netpay.com.mx
NETPAY_BASE_URL=http://localhost:5001
NETPAY_USERNAME=
NETPAY_PASSWORD=
NETPAY_AUTH_STRING=
NETPAY_GRANT_TYPE=password
NETPAY_SERIAL_NUMBER=
NETPAY_STORE_ID=

# URL pública/local que NetPay usará para mandar el webhook de confirmación
# (en producción, en la laptop Windows, suele ser algo como http://localhost:4000/webhooks/netpay)
NETPAY_WEBHOOK_PATH=/webhooks/netpay

# Solo la usa mocks/mock-netpay.js para saber a dónde llamar de vuelta
NETPAY_WEBHOOK_CALLBACK=http://localhost:4000/webhooks/netpay

# Log de diagnóstico del webhook (imprime el body completo recibido de
# Netpay) — usar "true" solo mientras se valida contra la terminal real;
# debe quedar en "false" (o sin definir) en producción.
NETPAY_DEBUG_LOG=false

# ---- dslrBooth (LumaBooth for Windows) ----
# Mientras no haya PC Windows con dslrBooth: dejar esto tal cual, apunta al
# mock local (node mocks/mock-dslrbooth.js), que también usa el puerto 1500.
DSLRBOOTH_BASE_URL=http://localhost:1500
DSLRBOOTH_API_PASSWORD=mock-password

# A dónde debe apuntar el Trigger URL (real o el mock lo usa directo)
DSLRBOOTH_TRIGGER_CALLBACK=http://localhost:4000/dslrbooth/events

# ---- Modo de cabina ----
# dslrbooth = llama al API de dslrBooth (lo definitivo, requiere Windows +
#             dslrBooth Professional instalado).
# direct    = controla cámara (gphoto2) e impresora (CUPS) directo en LINUX,
#             SOLO para demo temporal mientras no hay laptop Windows con dslrBooth.
# windirect = controla cámara (digiCamControl) e impresora (nativa de
#             Windows) directo en WINDOWS, SOLO para demo con hardware real
#             (cámara + impresora) antes de instalar dslrBooth.
BOOTH_MODE=dslrbooth

# ---- Cámara (solo se usa si BOOTH_MODE=direct o windirect) ----
CAMERA_CAPTURE_DIR=./captures
CAMERA_COUNTDOWN_SECONDS=3

# VID/PID de la cámara para el MONITOREO de hardware (ver
# src/hardwareWatch.js) — usado en dslrbooth Y windirect, vía WMI
# (Win32_PnPEntity), solo para confirmar presencia por USB, sin abrir
# sesión PTP. Defaults ya puestos para la Nikon D7200 de producción
# (confirmados en Administrador de dispositivos > D7200 > Detalles > Id.
# de hardware, 13-sep-2026: USB\VID_04B0&PID_0439). Si se cambia de cámara,
# actualizar aquí.
CAMERA_VID=04B0
CAMERA_PID=0439

# ---- Impresora (solo se usa si BOOTH_MODE=direct o windirect) ----
# Nombre EXACTO de la impresora:
#  - direct (Linux):    ver con `lpstat -p` o GET /diagnostics/printer
#  - windirect (Windows): ver con GET /diagnostics/printer (Get-Printer)
# NOTA: en dslrbooth (producción) este mismo nombre lo usa el monitoreo de
# hardware (src/services/windowsPrinterService.js#getPrinterStatus) para
# consultar el estado vía WMI — no imprime nada, solo lo consulta.
PRINTER_NAME=
PRINTER_COPIES=1

# ---- Monitoreo de hardware (cámara + impresora) — ver src/hardwareWatch.js ----
# Solo corre en BOOTH_MODE=dslrbooth o windirect (necesita WMI/PowerShell).
# Apaga por completo el monitoreo (loop de fondo + chequeo síncrono en
# POST /api/pay) sin tener que cambiar BOOTH_MODE — útil para probar en una
# máquina sin cámara/impresora conectadas, o si en campo el chequeo da más
# falsos positivos que valor. Con "false", /api/pay nunca lo bloquea y la
# pantalla 6 ("Cabina fuera de servicio") nunca se activa.
HARDWARE_MONITOR_ENABLED=true
# Cadencia normal: cada cuánto revisa mientras la cabina está "idle" (nadie
# pagando/en sesión). Antes de aceptar un pago SIEMPRE se hace además un
# chequeo síncrono fresco — este intervalo es solo para poder avisar por
# Discord ANTES de que llegue un cliente a una cabina ya rota.
HARDWARE_IDLE_POLL_MS=15000
# Cadencia acelerada mientras está marcada "fuera de servicio", para
# detectar la recuperación y reabrir la cabina sola (reintento automático).
HARDWARE_RETRY_POLL_MS=10000

# Webhook de un canal de Discord (gratis) para avisar cuando la cabina se
# marca fuera de servicio (y cuando se recupera sola). Se crea en
# Configuración del canal > Integraciones > Webhooks > Nuevo webhook.
# Tratar esta URL como secreta igual que las credenciales de NetPay — quien
# la tenga puede mandar mensajes al canal.
DISCORD_WEBHOOK_URL=

# ---- Solo BOOTH_MODE=windirect (Windows, hardware real sin dslrBooth) ----
# Ruta a CameraControlCmd.exe de digiCamControl. Ajustar si se instaló en
# otra carpeta (por default digiCamControl instala en Program Files (x86)).
DIGICAM_CONTROL_PATH=C:\Program Files (x86)\digiCamControl\CameraControlCmd.exe
# IMPORTANTE: si la app principal de digiCamControl (CameraControl.exe, la
# GUI) está abierta con una sesión activa, las fotos SIEMPRE caen en la
# carpeta de esa sesión — los flags /folder y /filename del CLI se ignoran.
# Copia aquí exactamente la ruta que muestra el campo "Folder" del panel
# "Sesión" en la GUI (ícono de engrane). El backend vigila esa carpeta,
# detecta la foto nueva después de disparar la captura, y la copia a
# CAMERA_CAPTURE_DIR con su propio nombre.
DIGICAM_SESSION_FOLDER=C:\Users\Photobooth\Pictures\digiCamControl\Session1
# Pausa (ms) entre copias al imprimir con mspaint /pt, que no soporta un
# parámetro nativo de "número de copias".
WINDOWS_PRINT_COPY_DELAY_MS=2000

# ---- Convivencia de pantallas: kiosco <-> LumaBooth (solo BOOTH_MODE=dslrbooth) ----
# LumaBooth es una app nativa de Windows con su propia ventana — el
# navegador del kiosco y LumaBooth se turnan el mismo espacio de pantalla
# dos veces por sesión. CONFIRMADO EN HARDWARE REAL (13-sep-2026) — ver
# "Convivencia visual/de foco..." en claude/Integración dslrbooth.md (doc
# del proyecto) para el detalle de la prueba. Cada llamada sigue siendo
# best-effort y nunca rompe el flujo si falla (el lockscreen de LumaBooth
# es la red de seguridad real). Poner en "false" desactiva el swap de foco
# por completo (el lockscreen se sigue usando igual).
KIOSK_WINDOW_FOCUS_ENABLED=true
# Nombre EXACTO del proceso (sin ".exe") tal como aparece en `Get-Process`
# en la máquina Windows real — en la laptop de producción es "LumaBooth"
# (confirmar ahí si se reinstala o cambia de máquina).
KIOSK_DSLRBOOTH_PROCESS_NAME=LumaBooth
# Nombre del proceso del navegador corriendo en modo kiosco — en la
# laptop de producción es "chrome" (confirmar con `Get-Process` si se usa
# otro navegador, p.ej. "msedge").
KIOSK_BROWSER_PROCESS_NAME=chrome
